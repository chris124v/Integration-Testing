server {
    listen 80;
    root /usr/share/nginx/html;

    # El navegador solo habla con el frontend; nginx reenvia /api/* al servicio Pedidos.
    location /api/ {
        proxy_pass ${PEDIDOS_URL}/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri /index.html;
    }
}
